{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/services/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/reviews(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/about(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/(my-bookings|contact|admin-login|privacy-policy)(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
